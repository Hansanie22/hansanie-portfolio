# ============================================================
# HansaniePortfolio — Git Ignore Rules
# ============================================================

# Maven / Java build artifacts
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper
.mvn/
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# Node / React build artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/

# npm / pnpm lock files (keep package-lock.json)
frontend/.pnpm-store/

# IDE Files
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment secrets — NEVER commit .env files
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Spring Boot H2 DB files (dev only)
*.db
*.mv.db
*.trace.db

# Docker
.dockerignore.swp

# Test reports
surefire-reports/
